# =============================================================================
# AtlasCore — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before starting.
# Never commit .env to version control.
# All secrets must be provided via environment variables — nothing is hardcoded.
#
# REQUIRED: Variables marked REQUIRED cause a hard startup failure if absent
#           or if they still contain a REPLACE_* placeholder value.
#           Settings validation rejects placeholder values at startup.
#
# PHASE-GATED: Variables marked with a phase (e.g. REQUIRED Phase 1B+) cause
#              a hard startup failure only when their module is first enabled.
#              They are ignored if the module is not yet active.
#
# Generate random secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Generate a Fernet key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
APP_NAME=AtlasCore
APP_VERSION=0.1.0
DEBUG=false                            # Set true only in development
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                        # json | text
REQUEST_ID_HEADER=X-Request-ID

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Bind address for the ASGI server inside its process/container.
# Docker Compose publishes the host port on 127.0.0.1 only (see docker-compose.yml).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8100                      # Matches local Compose (host: 127.0.0.1:8100)
BACKEND_WORKERS=1                      # Increase in production
BACKEND_RELOAD=false                   # true for development hot-reload
ALLOWED_ORIGINS=http://localhost:3100  # Comma-separated explicit allowlist
                                       # Wildcard * is incompatible with credentials:include

# -----------------------------------------------------------------------------
# Database — PostgreSQL 16 + pgvector
# NOTE: Passwords shown here are development-only local Docker credentials.
#       Use strong, unique credentials in staging and production.
# NOTE: Local Compose maps Postgres to 127.0.0.1:5433 (container port 5432).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://atlascore:change_in_production@localhost:5433/atlascore
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false                    # true logs all SQL — development only

# Separate sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://atlascore:change_in_production@localhost:5433/atlascore

# Analytics read-only connection — reserved for a later phase
# NOTE: atlascore_ro password is development-only; replace in production.
ANALYTICS_DATABASE_URL=postgresql://atlascore_ro:change_in_production@localhost:5433/atlascore_analytics
ANALYTICS_MAX_ROWS=10000               # Hard row limit on all analytical queries
ANALYTICS_QUERY_TIMEOUT=30            # Seconds
ANALYTICS_COST_LIMIT=1000             # Estimated query cost units

# -----------------------------------------------------------------------------
# Redis — single instance, key-prefix isolation
# NOTE: No logical DB numbers. All namespaces use key prefixes.
# NOTE: Use TEST_REDIS_KEY_PREFIX for test isolation, not a separate Redis DB.
# NOTE: Local Compose maps Redis to 127.0.0.1:6380 (container port 6379).
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX_SESSION=sess:
REDIS_KEY_PREFIX_LOCK=lock:
REDIS_KEY_PREFIX_RATE=rate:
REDIS_KEY_PREFIX_CACHE=cache:
REDIS_DEFAULT_TTL_SECONDS=3600

# Test isolation — tests use a distinct key prefix, not a separate DB number
TEST_REDIS_KEY_PREFIX=test:

# -----------------------------------------------------------------------------
# Security — Authentication
# REQUIRED: All secrets below are required for Phase 1A startup.
# Settings validation rejects any REPLACE_* placeholder at startup.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# -----------------------------------------------------------------------------

# JWT signing key — REQUIRED — ≥ 64 random bytes
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY_64_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token settings — REQUIRED
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_PEPPER=REPLACE_WITH_SECURE_RANDOM_KEY  # Prepended before BLAKE2b hash

# Argon2id password hashing — REQUIRED
# Pepper is prepended to password before hashing; stored separately from DB
ARGON2_PEPPER=REPLACE_WITH_SECURE_RANDOM_KEY
# Version number for the active pepper; increment on rotation
# Old peppers must be retained for verification until all passwords are re-hashed
ARGON2_PEPPER_VERSION=1

# CSRF protection — double-submit cookie pattern
# CSRF token is HMAC-SHA256(CSRF_SECRET, refresh_jti); set in a JS-readable cookie
# CSRF_SECRET — REQUIRED Phase 1A+
CSRF_SECRET=REPLACE_WITH_SECURE_RANDOM_KEY

# Pre-authentication session — single-purpose session between login steps
# SHA-256(PRE_AUTH_SESSION_PEPPER + raw_token) stored; raw token set as HttpOnly cookie
# PRE_AUTH_SESSION_PEPPER — REQUIRED Phase 1A+
PRE_AUTH_SESSION_PEPPER=REPLACE_WITH_SECURE_RANDOM_KEY
PRE_AUTH_SESSION_EXPIRE_MINUTES=5     # Cookie Max-Age=300; hard limit on step-2 window

# API key hashing — REQUIRED Phase 1B+ (when api_keys module is enabled)
API_KEY_PEPPER=REPLACE_WITH_SECURE_RANDOM_KEY   # BLAKE2b(pepper + raw_key)
API_KEY_PREFIX_LENGTH=8                          # Visible prefix length

# Invitation token hashing — REQUIRED Phase 1B+ (when invitations module is enabled)
# May share API_KEY_PEPPER or use a distinct pepper
INVITATION_TOKEN_PEPPER=REPLACE_WITH_SECURE_RANDOM_KEY

# Connector credential encryption — REQUIRED Phase 2+ (when connectors module is enabled)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ENCRYPTION_KEY_VERSION=1               # Increment when rotating key; old version kept for decryption

# Rate limiting (requests per minute per principal)
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_WRITE=20

# -----------------------------------------------------------------------------
# AI Providers
# NOTE: Model IDs shown below are examples; verify each provider's current
#       model catalogue before deployment. These may change over time.
# -----------------------------------------------------------------------------
# Grounded answering provider (Phase 2C/2D)
ANSWER_PROVIDER=deterministic-test    # deterministic-test | openai | anthropic
ANSWER_DEMO_MODE=false                # true forces deterministic-test regardless of ANSWER_PROVIDER
ANSWER_MAX_EVIDENCE_ITEMS=10
ANSWER_MAX_CHARS_PER_CHUNK=1500
ANSWER_REQUIRE_MEDIUM_BAND=true

LLM_PROVIDER=mock                     # Reserved / legacy alias surface — prefer ANSWER_PROVIDER
EMBEDDING_PROVIDER=mock               # mock | openai | cohere
RERANKING_PROVIDER=mock               # mock | cohere | jina
MODERATION_PROVIDER=mock              # mock | openai

# OpenAI (optional — leave empty when using deterministic-test / mock)
OPENAI_API_KEY=
OPENAI_DEFAULT_CHAT_MODEL=gpt-4o      # Example — verify current availability
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60
# OpenAI-compatible chat completions endpoint (default OpenAI URL).
# Override only for trusted OpenAI-compatible gateways. Never put secrets here.
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Anthropic (optional — leave empty when using deterministic-test / mock)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_CHAT_MODEL=claude-opus-4-5  # Example — verify current availability
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_TIMEOUT=60

# Google Gemini (optional — mock provider used if absent)
GEMINI_API_KEY=
GEMINI_DEFAULT_CHAT_MODEL=gemini-2.0-flash   # Example — verify current availability
GEMINI_TIMEOUT=60

# Cohere (optional — mock reranking used if absent)
COHERE_API_KEY=
COHERE_RERANKING_MODEL=rerank-english-v3.0   # Example — verify current availability

# -----------------------------------------------------------------------------
# Model budgets (per workflow execution unless overridden at workflow level)
# -----------------------------------------------------------------------------
DEFAULT_MAX_MODEL_CALLS=20
DEFAULT_MAX_TOOL_CALLS=30
DEFAULT_MAX_STEPS=50
DEFAULT_COST_BUDGET_USD=1.00
DEFAULT_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Knowledge system
# -----------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
EMBEDDING_DIMENSIONS=1536             # Must match embedding model
RETRIEVAL_TOP_K=10
RERANKING_TOP_K=5
RETRIEVAL_MIN_CONFIDENCE=0.3
MAX_DOCUMENT_SIZE_BYTES=52428800      # 50 MB

# Web ingestion SSRF protection
WEB_INGESTION_ALLOWED_DOMAINS=        # Comma-separated allowlist — empty = deny all external
WEB_INGESTION_TIMEOUT=15
WEB_INGESTION_MAX_RESPONSE_BYTES=5242880

# -----------------------------------------------------------------------------
# Workflow engine
# -----------------------------------------------------------------------------
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_BACKOFF_SECONDS=5
WORKFLOW_MAX_CONCURRENT_EXECUTIONS=10

# Durable workflow state retention — must be longer than any approval expiration
# to avoid losing paused executions before they can be approved.
WORKFLOW_STATE_TTL_SECONDS=604800     # 7 days (covers default 24h approval window + buffer)

# Human approval
APPROVAL_EXPIRATION_HOURS=24
# NOTE: There is no auto-approve setting. Approval must always go through the
#       approval flow, even in development. Test approval via the API or UI.

# -----------------------------------------------------------------------------
# MCP — REQUIRED Phase 6+ (when MCP module is enabled)
# -----------------------------------------------------------------------------
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=9000
MCP_SERVER_SECRET=REPLACE_WITH_SECURE_RANDOM_KEY
MCP_CLIENT_TIMEOUT=30
MCP_TOOL_ALLOWLIST=                   # Comma-separated; empty = deny all external tools

# -----------------------------------------------------------------------------
# Email (optional — required for Phase 5 email tool)
# Mock mailer used if SMTP_HOST is absent.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@atlascore.example
SMTP_USE_TLS=true
MOCK_MAIL_DIR=mock_mail               # Directory for mock email files in development

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=atlascore-backend
OTEL_EXPORTER_ENDPOINT=http://localhost:4317   # gRPC OTLP endpoint (stdout exporter if absent)
OTEL_TRACES_SAMPLER=always_on

# Cost tracking
COST_TRACKING_ENABLED=true
COST_ALERT_THRESHOLD_USD=10.00       # Alert when workspace exceeds this per day

# -----------------------------------------------------------------------------
# Audit
# NOTE: AUDIT_LOG_RETENTION_DAYS controls a privileged maintenance job,
#       not application-layer deletion. The application role cannot delete
#       audit rows. Set to 0 to retain indefinitely in development.
# -----------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=0           # 0 = indefinite (development); set 365+ in production
AUDIT_EXPORT_MAX_ROWS=100000

# -----------------------------------------------------------------------------
# Development / testing only
# These variables have no effect when APP_ENV=production
# NOTE: Database passwords here are development-only local Docker credentials.
# NOTE: Tests use TEST_REDIS_KEY_PREFIX for isolation, not a separate DB number.
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://atlascore:change_in_production@localhost:5433/atlascore_test
TEST_REDIS_KEY_PREFIX=test:
FAKER_SEED=42
